diff --git a/tests/testthat/test-taxonomy-worms.R b/tests/testthat/test-taxonomy-worms.R
index e6f7c4b..7e39b7b 100644
--- a/tests/testthat/test-taxonomy-worms.R
+++ b/tests/testthat/test-taxonomy-worms.R
@@ -176,3 +176,59 @@ test_that("an AphiaID unknown to WoRMS falls back to the prey name", {
