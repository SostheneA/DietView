+\usage{
+dv_parse_lineage(
+  data,
+  col,
+  ranks = c("kingdom", "phylum", "class", "order", "family", "genus", "species"),
+  sep = ";",
+  format = c("auto", "prefixed", "positional"),
+  name_col = "prey_name",
+  placeholders = c("", "na", "nan", "none", "null", "unassigned", "unclassified",
+    "uncultured", "unidentified", "unknown", "metagenome", "environmental sample")
+)
+}
+\arguments{
+\item{data}{A data.frame.}
+
+\item{col}{Name of the column holding the lineage string.}
+
+\item{ranks}{Ranks to create, coarse to fine (default the seven flagship
+ranks). For positional strings they must follow the order of the fields.}
+
+\item{sep}{Field separator (default \code{";"}).}
+
+\item{format}{\code{"auto"} (default), \code{"prefixed"} or \code{"positional"}.}
+
+\item{name_col}{If not \code{NULL} (default \code{"prey_name"}), a column with the
